# Use a camera index, video path, or RTSP URL. Protect this file if it contains credentials.
SENTINEL_SOURCE=0
SENTINEL_HEADLESS=1
SENTINEL_MODEL_PATH=/opt/sentinel/share/sentinel/models/yolo/model_320.onnx
SENTINEL_CLIP_DIR=/var/lib/sentinel/clips
SENTINEL_KPI_DIR=/var/lib/sentinel/kpi

# Pi 5 4 GB baseline. Benchmark intervals 2, 3, and 4 on the actual camera stream.
SENTINEL_INFERENCE_INTERVAL=3

# At 1280x720, 30 uncompressed frames use roughly 83 MiB before save-time copies.
SENTINEL_CLIP_BUFFER_FRAMES=30

# Keep the newest clips and delete older AVI files. Set to 0 for unlimited.
SENTINEL_MAX_CLIPS=100

# Periodic capture and inference measurements written to journalctl.
SENTINEL_TELEMETRY_INTERVAL_SEC=30

# SceneState JSON is useful for diagnostics but verbose in journald.
SENTINEL_SCENE_INTERVAL_SEC=30

# Queue at most one event-triggered reasoning request per cooldown window.
SENTINEL_REASONING_COOLDOWN_SEC=60
