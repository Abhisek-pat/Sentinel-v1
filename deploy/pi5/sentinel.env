# Use a camera index, video path, or RTSP URL. Protect this file if it contains credentials.
SENTINEL_SOURCE=0
SENTINEL_HEADLESS=1
SENTINEL_MODEL_PATH=/opt/sentinel/share/sentinel/models/yolo/model_320.onnx
SENTINEL_CLIP_DIR=/var/lib/sentinel/clips

# Pi 5 4 GB baseline. Benchmark intervals 2, 3, and 4 on the actual camera stream.
SENTINEL_INFERENCE_INTERVAL=3

# At 1280x720, 30 uncompressed frames use roughly 83 MiB before save-time copies.
SENTINEL_CLIP_BUFFER_FRAMES=30
