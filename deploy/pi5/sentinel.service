[Unit]
Description=Sentinel person monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
SupplementaryGroups=video render
WorkingDirectory=/opt/sentinel
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=LD_LIBRARY_PATH=/opt/onnxruntime/lib
ExecStart=/opt/sentinel/bin/sentinel
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinel

[Install]
WantedBy=multi-user.target
