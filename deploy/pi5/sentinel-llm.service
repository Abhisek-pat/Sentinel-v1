[Unit]
Description=Sentinel reasoning service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
EnvironmentFile=-/etc/sentinel/llm.env
Environment=SENTINEL_KPI_DIR=/var/lib/sentinel/kpi
ExecStart=/opt/sentinel/llm-venv/bin/uvicorn app:app --app-dir /opt/sentinel/share/sentinel/llm_service --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinel/kpi

[Install]
WantedBy=multi-user.target
