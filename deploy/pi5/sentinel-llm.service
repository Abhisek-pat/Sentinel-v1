[Unit]
Description=Sentinel reasoning service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
Environment=SENTINEL_LLM_PROVIDER=mock
ExecStart=/opt/sentinel/llm-venv/bin/uvicorn app:app --app-dir /opt/sentinel/share/sentinel/llm_service --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
