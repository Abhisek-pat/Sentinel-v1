# Keep mock as the default until a real model profile has been validated.
SENTINEL_LLM_PROVIDER=mock

# JSON array of OpenAI-compatible model profiles. Keep this value on one line.
# A profile can target a hosted endpoint or a local server exposing
# /v1/chat/completions.
SENTINEL_LLM_PROFILES_JSON='[]'

# Event-driven reasoning uses the selected provider, then falls back to mock.
SENTINEL_LLM_FALLBACK_PROVIDER=mock
SENTINEL_REASONING_POLL_SEC=1

# Example API-key variable referenced by a profile's api_key_env field.
# SENTINEL_MODEL_A_API_KEY=replace-me
